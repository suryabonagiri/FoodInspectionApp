rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /restaurants/{restaurantId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /inspections/{inspectionId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
